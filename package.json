{
  "name": "event-system-be",
  "version": "0.0.1",
  "description": "Company Event System backend — NestJS 11 · Hexagonal/DDD · CQRS (walking skeleton)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node -r ts-node/register -r tsconfig-paths/register src/main.ts",
    "start:dev": "node -r ts-node/register -r tsconfig-paths/register --watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./jest-e2e.config.ts --runInBand --forceExit",
    "arch": "depcruise src",
    "map": "node scripts/gen-map.mjs",
    "map:check": "node scripts/gen-map.mjs && git diff --exit-code -- docs/architecture-map.md",
    "openapi:gen": "node -r ts-node/register -r tsconfig-paths/register scripts/gen-openapi.ts",
    "openapi:check": "pnpm openapi:gen && git diff --exit-code -- docs/openapi.json",
    "migration:run": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:run -d src/data-source.ts",
    "migration:revert": "node -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js migration:revert -d src/data-source.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/cqrs": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^5.0.0",
    "@nestjs/swagger": "^11.4.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "google-auth-library": "^10.9.0",
    "nestjs-pino": "^4.6.1",
    "oxide.ts": "^1.1.0",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "dependency-cruiser": "^16.3.0",
    "eslint": "^10.6.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^6.0.2",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.62.1"
  }
}
